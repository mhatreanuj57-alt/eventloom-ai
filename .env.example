# Copy to .env.local and add your own server-side credential.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Legacy development-only studio token when Supabase is absent.
# Production generation requires Supabase accounts and shared quota migrations.
EVENTLOOM_ACCESS_TOKEN=
# Public connection details; never place a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
